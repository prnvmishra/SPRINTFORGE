# ---------------------------------------------------------------- core
ENVIRONMENT=development
# SQLite by default so the app runs with zero infrastructure.
# Postgres (local or serverless e.g. Neon/Supabase) works as a drop-in:
#   postgresql://user:password@host/dbname?sslmode=require
# Bare postgresql:// URLs are routed to the psycopg 3 driver automatically.
DATABASE_URL=sqlite:///./sprintforge.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Development convenience: trust any localhost port so the Next dev server can
# move ports. Set to an empty string in production and use CORS_ORIGINS only.
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1)(:\d+)?

# ------------------------------------------------------------------ AI
# mock | openai | gemini
# Falls back to "mock" automatically when the selected provider has no key,
# so the whole application works without any external credentials.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint. Examples:
#   OpenAI     https://api.openai.com/v1          (model: gpt-4o-mini)
#   OpenRouter https://openrouter.ai/api/v1       (model: openai/gpt-4o-mini)
OPENAI_BASE_URL=https://api.openai.com/v1
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Completion cap. Two opposite pressures: gateways such as OpenRouter reserve the
# model's whole context window when no cap is sent (so a low balance needs ~400),
# while Gemini's thinking models bill reasoning against this budget and return
# empty text if it runs out (so they need ~2000).
AI_MAX_OUTPUT_TOKENS=2000

# ------------------------------------------------------ code execution
# local  - subprocess with resource limits (DEVELOPMENT ONLY, not a sandbox)
# piston - public/self-hosted Piston, recommended for anything shared
# judge0 - Judge0 via RapidAPI
# local  = subprocess in the API process; DEV ONLY, not a sandbox
# piston = self-hosted sandboxed judge (see docker-compose.judge.yml)
CODE_EXECUTION_PROVIDER=local
# Public instance is rate-limited; self-hosted is http://localhost:2000/api/v2
PISTON_URL=https://emkc.org/api/v2/piston
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
EXECUTION_TIMEOUT_SECONDS=10
