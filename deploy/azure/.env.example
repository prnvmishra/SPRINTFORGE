# Azure Deployment Environment Variables
# Copy this to .env and fill in actual values after Azure setup

# Core Configuration
ENVIRONMENT=production

# Azure PostgreSQL Database
# Format: postgresql://admin:password@server.postgres.database.azure.com:5432/dbname?sslmode=require
# Get this from Azure script output or: az postgres server show-connection-string
DATABASE_URL=postgresql://sprintforge:your-password@sprintforge-db-xxx.postgres.database.azure.com:5432/sprintforge?sslmode=require

# Security
# Generate with: openssl rand -hex 32
AUTH_SECRET=your-64-character-random-secret-here

# CORS Configuration
# Your Vercel frontend URL
CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGIN_REGEX=

# AI Configuration
# Use 'mock' for free tier, or 'gemini' with API key
AI_PROVIDER=mock
# AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Code Execution
# Use 'piston' for public Piston (recommended for Azure)
# Use 'local' only for development (not recommended for production)
CODE_EXECUTION_PROVIDER=piston
PISTON_URL=https://emkc.org/api/v2/piston
EXECUTION_TIMEOUT_SECONDS=10