# Production Environment Variables for Oracle Cloud Deployment
# Copy this to .env and fill in the actual values

# Core Configuration
ENVIRONMENT=production

# Database (Neon PostgreSQL)
# Get this from Neon console: https://console.neon.tech
DATABASE_URL=postgresql://neondb_owner:your-password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Security
# Generate with: openssl rand -hex 32
AUTH_SECRET=your-64-character-random-secret-here

# CORS
# Your Vercel frontend URL
CORS_ORIGINS=https://your-app.vercel.app

# AI Configuration
# Use 'mock' for free tier, or 'gemini' with API key
AI_PROVIDER=mock
# AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Code Execution (Piston)
# These are configured for local Piston container
CODE_EXECUTION_PROVIDER=piston
PISTON_URL=http://localhost:2000/api/v2
EXECUTION_TIMEOUT_SECONDS=10